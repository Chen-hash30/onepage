# Files to ignore for Git

# Environment and configuration
.env
.env.local
.env.*.local
.installed

# Logs
logs/
*.log

# Uploads (user content)
uploads/pages/*
!uploads/pages/.gitkeep

# Temporary files
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# IDE and editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Dependencies (if using Composer)
/vendor/

# Build artifacts
/build/
/dist/

# Test coverage
coverage/
*.coverage

# Backup files
*.bak
*.backup
*.sql.backup

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# Package files
*.zip
*.tar.gz
*.rar

# Security sensitive files
*.pem
*.key
*.crt
