# ====================
# 应用配置
# ====================
# 应用名称
APP_NAME=OnePage

# 应用 URL（请修改为你的域名）
APP_URL=https://your-domain.com

# ====================
# 数据库配置
# ====================
# 数据库主机地址
DB_HOST=localhost

# 数据库名称（请修改为你的数据库名）
DB_NAME=onepage

# 数据库用户名（请修改为你的数据库用户名）
DB_USER=onepage

# 数据库密码（请修改为你的数据库密码）
DB_PASS=your_secure_password_here

# ====================
# AI 审核配置（可选）
# ====================
# 是否启用 AI 审核（true/false）
AI_ENABLED=false

# NVIDIA NIM API 密钥（从 https://build.nvidia.com/ 获取）
AI_API_KEY=

# AI API 地址（通常不需要修改）
AI_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# AI 模型名称（通常不需要修改）
AI_MODEL=qwen/qwen3.5-122b-a10b

# AI 审核阈值（0-10，数值越高审核越严格）
AI_THRESHOLD=6.0

# ====================
# 邮件配置（可选）
# ====================
# 邮件发送方式（phpmail/smtp）
MAIL_METHOD=phpmail

# SMTP 服务器地址（如果使用 SMTP）
MAIL_HOST=smtp.example.com

# SMTP 端口（通常为 587 或 465）
MAIL_PORT=587

# SMTP 用户名（如果使用 SMTP）
MAIL_USERNAME=your_email@example.com

# SMTP 密码（如果使用 SMTP）
MAIL_PASSWORD=your_email_password

# 发件人邮箱地址
MAIL_FROM_EMAIL=noreply@example.com

# 发件人名称
MAIL_FROM_NAME=OnePage System

# 加密方式（tls/ssl）
MAIL_ENCRYPTION=tls

# ====================
# 管理员配置
# ====================
# 管理员邮箱（安装时设置）
ADMIN_EMAIL=admin@example.com
